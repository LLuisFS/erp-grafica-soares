# Pagamentos (Asaas Sandbox)
ASAAS_ENV=sandbox
ASAAS_API_KEY='$aact_hmlg_SUA_CHAVE_AQUI'
ASAAS_WEBHOOK_TOKEN=

# Cloudflare R2 (Storage de Artes)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=soares-artes-dev

# Base de Dados (Supabase / PostgreSQL)
DATABASE_URL=        # Transaction Pooler (usado pela API em execução)
DIRECT_URL=          # Direct Connection (usado pelo Drizzle para migrations)

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=    # Qualquer texto secreto criado por você para validar o webhook

# Redis (Filas BullMQ)
REDIS_URL=

# PostgreSQL Local via Docker (alternativa offline ao SUPABASE_TRANSACTION_POOLER / DIRECT_CONNECTION)
LOCAL_DATABASE_URL=postgresql://

# Seed Inicial (Admin Gráfica Soares)
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_PIN=""

# API NestJS & Autenticação JWT
API_PORT=
JWT_SECRET=
JWT_EXPIRES_IN=