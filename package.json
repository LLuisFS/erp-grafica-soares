{
  "name": "erp-grafica-soares",
  "version": "0.1.0",
  "private": true,
  "description": "ERP/MIS Gráfico com integração WhatsApp e pagamento modular - Gráfica Soares",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @soares/database db:generate",
    "db:migrate": "pnpm --filter @soares/database db:migrate",
    "db:seed": "pnpm --filter @soares/database db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}